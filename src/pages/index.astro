---
import { Image } from "astro:assets"
import Analytics from "@vercel/analytics/astro"
import portrait from "@/assets/me-square.png"
import { interests, projects } from "@/components/portfolio/data"
import ImageViewer from "@/components/portfolio/image-viewer.astro"
import Project from "@/components/portfolio/project.astro"
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta content="width=device-width, initial-scale=1" name="viewport">
        <meta
            content="Simon Bechard, fullstack developer in Brisbane. Personal projects, automation and things I make."
            name="description"
        >
        <title>Simon Bechard - Fullstack Developer</title>
        <link href="/favicon.ico" rel="icon">
        <link href="https://fonts.googleapis.com" rel="preconnect">
        <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap"
            rel="stylesheet"
        >
    </head>
    <body class="field-notes">
        <a class="skip" href="#main">Skip to content</a>

        <main class="field-main" id="main">
            <section class="field-intro">
                <h1>I like to<br><em>automate</em> things.</h1>
                <div class="field-bio">
                    <Image alt="Simon Bechard" src={portrait} width={220} />
                    <p>
                        Hello, I'm Simon Bechard, a Brisbane based software engineer.<br>I build things that make my
                        life easier.
                    </p>
                    <div class="bio-contacts">
                        <a class="bio-contact" href="mailto:simon@bechard.dev">Email me ↗</a>
                        <a class="bio-contact" href="https://t.me/simbech" rel="noopener" target="_blank">Telegram ↗</a>
                    </div>
                </div>
            </section>
            <section class="field-work" id="work">
                <div class="section-heading">
                    <h2>A few things I've made</h2>
                </div>
                {projects.map(project => <Project project={project}/>)}
            </section>
            <section class="field-aside">
                <h2>Away from the keyboard</h2>
                <p>Usually playing padel, printing something for my toddler, or tinkering with Home Assistant.</p>
                <p class="interest-list">{interests.join(" / ")}</p>
            </section>
        </main>
        <footer>
            <a class="footer-email" href="mailto:simon@bechard.dev">simon@bechard.dev</a>
            <nav aria-label="Social links">
                <a href="https://github.com/simbesh" rel="noopener" target="_blank">GitHub</a
                ><a href="https://www.linkedin.com/in/simon-bechard-237470196/" rel="noopener" target="_blank"
                    >LinkedIn</a
                >
            </nav>
            <small>© 2026 Simon Bechard</small>
        </footer>
        <ImageViewer />
        <Analytics />
    </body>
</html>
<style>
    :global(*) {
        box-sizing: border-box;
    }
    :global(html) {
        scroll-behavior: smooth;
        scroll-padding-top: 24px;
    }
    :global(body) {
        margin: 0;
    }
    body {
        --paper: #f4f1e9;
        --ink: #282d26;
        --muted: #606457;
        --accent: #5a672f;
        --line: #cbcdbf;
        --plate: #e6e6de;
        font-family: "DM Sans", sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: var(--ink);
        background: var(--paper);
    }
    :global(::selection) {
        color: #20251a;
        background: #c8d796;
    }
    :global(a) {
        color: inherit;
        text-underline-offset: 5px;
    }
    :global(a:hover) {
        text-decoration-thickness: 2px;
    }
    :global(a:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 5px;
    }
    :global(img) {
        max-width: 100%;
    }
    :global(h1),
    :global(h2),
    :global(h3) {
        text-wrap: balance;
    }
    .skip {
        position: fixed;
        top: -80px;
        left: 16px;
        z-index: 20;
        padding: 10px 18px;
        color: var(--paper);
        background: var(--ink);
    }
    .skip:focus {
        top: 12px;
    }
    h1 {
        margin: 0;
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.04em;
    }
    h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }
    p {
        margin: 0 0 20px;
    }
    .section-heading {
        display: flex;
        gap: 20px;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 32px;
    }
    .section-heading span {
        font-size: 12px;
        color: var(--muted);
    }
    footer {
        display: flex;
        flex-wrap: wrap;
        gap: 26px;
        align-items: center;
        max-width: 1200px;
        padding: 36px 0 40px;
        margin: 0 auto;
        font-size: 13px;
        border-top: 1px solid var(--line);
    }
    footer nav {
        display: flex;
        gap: 20px;
        margin-left: auto;
    }
    footer small {
        font-size: 11px;
        color: var(--muted);
    }
    .footer-email {
        text-decoration: none;
    }
    .field-main {
        max-width: 1100px;
        margin: auto;
    }
    .field-intro {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 80px;
        align-items: start;
        padding: 72px 0 70px;
    }
    .field-intro h1 {
        padding-top: 20px;
        font-family: "DM Serif Display", serif;
        font-size: clamp(50px, 6.6vw, 88px);
    }
    .field-intro h1 em {
        font-weight: 400;
        color: var(--accent);
    }
    .field-bio img {
        width: 100px;
        height: 110px;
        margin-bottom: 18px;
        object-fit: cover;
    }
    .field-bio p {
        max-width: 33ch;
        font-size: 16px;
    }
    .bio-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }
    .bio-contact {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-size: 14px;
    }
    .field-work {
        padding-top: 32px;
        padding-bottom: 60px;
        border-top: 1px solid var(--line);
    }
    .field-work h2,
    .field-aside h2 {
        font-family: "DM Serif Display", serif;
    }
    .field-work :global(.project) {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 44px;
        align-items: center;
        margin-bottom: 58px;
    }
    .field-work :global(.project-info) {
        padding: 0;
    }
    .field-work :global(h3) {
        font-family: "DM Serif Display", serif;
        font-size: 34px;
        font-weight: 400;
    }
    .field-work :global(.project-bottom) {
        display: grid;
        gap: 16px;
    }
    .field-aside {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px 70px;
        padding: 45px 0 70px;
        border-top: 1px solid var(--line);
    }
    .field-aside p {
        max-width: 50ch;
    }
    .field-aside .interest-list {
        grid-column: 2;
        font-size: 12px;
        color: var(--muted);
    }
    .field-notes footer {
        max-width: 1100px;
    }
    @media (max-width: 1300px) {
        .field-main,
        .field-notes footer {
            margin-right: 40px;
            margin-left: 40px;
        }
    }
    @media (max-width: 950px) {
        .field-intro {
            gap: 35px;
        }
        .field-work :global(.project) {
            grid-template-columns: 1.2fr 1fr;
            gap: 30px;
        }
    }
    @media (max-width: 650px) {
        .field-main,
        .field-notes footer {
            margin-right: 22px;
            margin-left: 22px;
        }
        .field-intro {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 35px 0 42px;
        }
        .field-intro h1 {
            padding: 0;
            font-size: 56px;
        }
        .field-bio {
            display: grid;
            grid-template-columns: 80px 1fr;
            gap: 0 20px;
        }
        .field-bio img {
            width: 80px;
            height: 100px;
        }
        .bio-contacts {
            grid-column: 2;
        }
        .field-bio p {
            font-size: 14px;
        }
        .section-heading {
            align-items: start;
        }
        .section-heading h2 {
            font-size: 24px;
        }
        .section-heading span {
            max-width: 100px;
            text-align: right;
        }
        .field-work :global(.project) {
            display: block;
            margin-bottom: 44px;
        }
        .field-work :global(.project-info) {
            padding-top: 20px;
        }
        .field-work {
            padding-bottom: 10px;
        }
        .field-aside {
            display: block;
            padding: 30px 0;
        }
        .field-aside h2 {
            margin-bottom: 20px;
        }
        .field-aside p {
            font-size: 14px;
        }
        footer {
            gap: 20px;
            padding: 28px 0;
        }
        footer small {
            width: 100%;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        :global(html) {
            scroll-behavior: auto;
        }
    }
</style>
